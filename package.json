{
  "name": "todo-saas",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" ",
    "prepare": "husky install",
    "build-sw": "esbuild public/notifications-sw.ts --outdir=public --bundle --sourcemap --minify --format=esm --legal-comments=external",
    "generate-wp-keys": "node scripts/generate-web-push-keys.js",
    "test": "jest",
    "test:watch": "npm run test -- --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@aws-sdk/client-s3": "3.620.0",
    "@aws-sdk/s3-request-presigner": "3.620.0",
    "@faker-js/faker": "^9.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@next/bundle-analyzer": "^14.2.7",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@sentry/nextjs": "^8.34.0",
    "@t3-oss/env-nextjs": "0.9.1",
    "@tanstack/react-query": "^5.55.0",
    "@tanstack/react-query-devtools": "^5.55.0",
    "@tanstack/react-table": "^8.20.5",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "compressorjs": "^1.2.1",
    "date-fns": "^3.6.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.436.0",
    "mime-types": "^2.1.35",
    "next": "^14.2.7",
    "next-auth": "^5.0.0-beta.22",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.3.0",
    "nextjs-toploader": "^2.6.12",
    "nodemailer": "^6.9.15",
    "nuqs": "^1.19.1",
    "quill": "^2.0.2",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.53.0",
    "react-input-mask": "^2.0.4",
    "react-quill": "^2.0.0",
